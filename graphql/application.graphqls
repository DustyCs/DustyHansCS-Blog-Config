type User {
    id: ID
    username: String
}

type Post {
    id: ID
    content: String
    user: User
}

type Comment {
    id: ID!
    content: String!
    user: User!
    post: Post!
}

type Query {
    hello: String
    comments: [Comment]
    comment(id: ID!): Comment
}

type Mutation {
    hello: String
    createComment(content: String!): Comment
    updateComment(id: ID!, content: String!): Comment
    deleteComment(id: ID!): Comment
}